# Copy this file to .env and fill in your own values.
# Never commit the real .env file: it is listed in .gitignore.
# Leave the DB_ settings empty to run with an in-memory store instead.
PORT=3000
DB_USER=
DB_PASS=
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=Gym
# set to true only for a local/dev server with a self-signed certificate
DB_TRUST_SERVER_CERTIFICATE=false
